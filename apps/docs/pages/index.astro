---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { NeonAurora } from "@neon-ui/registry/components/neon-aurora/neon-aurora";
import InstallationCommand from "../demos/installation-command";

const { config, navigation: nav } = data;

// The stock header in PageLayout honors tab.href: point the Docs tab
// at the installation page (its path stays "/" for sidebar scoping).
const navigation = {
  ...nav,
  tabs: nav.tabs.map((tab) =>
    tab.path === "/" ? { ...tab, href: "/installation" } : tab
  ),
};
---

{/*
 * The landing is a dark stage: the aurora shader, the scrim, and the headline
 * are all painted against #000, so a light theme leaves a white header sitting
 * on a black hero. Pin this one route to dark before first paint and hide the
 * theme controls here, rather than half-theming a page that is one big image.
 * Every other route keeps the visitor's stored choice.
 */}
<PageLayout
  site={{ title: config.title }}
  logo={config.logo}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  favicon={config.favicon}
  searchEnabled={config.search.enabled}
  ogImage="/og-home.png"
  page={{
    title: "Neon UI — The UI layer for building with Neon",
    description: "The UI layer for building with Neon.",
    route: "/",
  }}
>
  <main class="stage">
    <NeonAurora className="aurora" client:load />
    <div class="scrim"></div>
    <div class="content">
      <h1>
        The UI layer for<br /><span class="accent"
          >building with&nbsp;Neon.</span
        >
      </h1>
      <div class="actions">
        <a class="btn-primary" href="/agent/agent-chat">Browse components</a>
        <div class="install">
          <InstallationCommand
            className="hero-command"
            client:media="(min-width: 40rem)"
            command="npx shadcn@latest add https://ui.neon.com/r/auth-form.json"
          />
        </div>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  /*
   * The hero follows the theme. The aurora is an additive neon field built to
   * glow on black, so light mode does not recolor it: it inverts the rendered
   * frame and rotates the hue back, which turns the black backdrop white and
   * keeps the bars in the brand hues, reading as ink on paper instead of a
   * black slab under a white header.
   */
  .stage {
    position: relative;
    height: calc(100dvh - 4rem);
    min-height: 480px;
    overflow: hidden;
    background: var(--background);
  }

  .stage :global(.aurora) {
    position: absolute;
    inset: 0;
  }

  :global(:root:not([data-theme="dark"])) .stage :global(.aurora) {
    filter: invert(1) hue-rotate(180deg);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 85%) 0%,
      rgb(0 0 0 / 35%) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  /* The scrim exists to hold the headline legible, so it flips with the page. */
  :global(:root:not([data-theme="dark"])) .scrim {
    background: linear-gradient(
      to top,
      rgb(255 255 255 / 92%) 0%,
      rgb(255 255 255 / 55%) 35%,
      transparent 65%
    );
  }

  .content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 3rem clamp(1.5rem, 6vw, 5rem) 4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--foreground);
  }

  .accent {
    background: linear-gradient(to right, #00e599, #38bdf8);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* Brand green at full brightness fails contrast on white; these are the same
   * two hues darkened until the phrase holds up against the light scrim. */
  :global(:root:not([data-theme="dark"])) .accent {
    background: linear-gradient(to right, #00875a, #1d6fd4);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background: color-mix(in oklch, var(--primary) 88%, white);
  }

  /* The install command is a desktop affordance: on a phone it wraps
   * badly and nobody pastes shell commands from there anyway. */
  .install {
    display: contents;
  }

  @media (max-width: 39.9375rem) {
    .install {
      display: none;
    }
  }



  @media (prefers-reduced-motion: reduce) {
    .btn-primary {
      transition: none;
    }
  }
</style>

