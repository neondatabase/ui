---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { NeonAurora } from "@neon-ui/registry/components/neon-aurora/neon-aurora";
import InstallPicker from "../demos/install-picker";

const { config, navigation: nav } = data;

// The stock header in PageLayout honors tab.href: point the Docs tab
// at the installation page (its path stays "/" for sidebar scoping).
const navigation = {
  ...nav,
  tabs: nav.tabs.map((tab) =>
    tab.path === "/" ? { ...tab, href: "/installation" } : tab
  ),
};
---

<PageLayout
  site={{ title: config.title }}
  logo={config.logo}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  favicon={config.favicon}
  searchEnabled={config.search.enabled}
  ogImage="/og-home.png"
  page={{
    title: "Neon UI — The UI layer for building with Neon",
    description: "The UI layer for building with Neon.",
    route: "/",
  }}
>
  <main class="stage">
    <NeonAurora className="aurora" client:load />
    <div class="scrim"></div>
    <div class="content">
      <h1>
        The UI layer for<br /><span class="accent"
          >building with&nbsp;Neon.</span
        >
      </h1>
      <div class="actions">
        <a class="btn-primary" href="/agent/agent-chat">Browse components</a>
        <div class="install">
          <InstallPicker client:media="(min-width: 40rem)" />
        </div>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .stage {
    position: relative;
    height: calc(100dvh - 4rem);
    min-height: 480px;
    overflow: hidden;
    background: #000;
  }

  .stage :global(.aurora) {
    position: absolute;
    inset: 0;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 85%) 0%,
      rgb(0 0 0 / 35%) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  .content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 3rem clamp(1.5rem, 6vw, 5rem) 4rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
  }

  .accent {
    background: linear-gradient(to right, #00e599, #38bdf8);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 1.25rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    box-shadow: 0 0 24px -6px var(--primary);
    transition: box-shadow 0.2s ease;
  }

  .btn-primary:hover {
    box-shadow: 0 0 36px -6px var(--primary);
  }

  /* The install command is a desktop affordance: on a phone it wraps
   * badly and nobody pastes shell commands from there anyway. */
  .install {
    display: contents;
  }

  @media (max-width: 39.9375rem) {
    .install {
      display: none;
    }
  }



  @media (prefers-reduced-motion: reduce) {
    .btn-primary {
      transition: none;
    }
  }
</style>

