---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import ChangelogTimeline from "../demos/changelog-timeline";
import Footer from "../components/blume/footer.astro";

const { config, navigation: nav } = data;

// The stock header in PageLayout honors tab.href: point the Docs tab
// at the installation page (its path stays "/" for sidebar scoping).
const navigation = {
  ...nav,
  tabs: nav.tabs.map((tab) =>
    tab.path === "/" ? { ...tab, href: "/installation" } : tab
  ),
};
---

<PageLayout
  site={{ title: config.title }}
  logo={config.logo}
  navigation={navigation}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  favicon={config.favicon}
  searchEnabled={config.search.enabled}
  page={{
    title: "Changelog — Neon UI",
    description: "What landed in Neon UI, and when.",
    route: "/changelog",
  }}
>
  <main class="mx-auto w-full max-w-3xl px-6 py-16">
    <h1 class="font-semibold text-3xl text-foreground tracking-tight">
      Changelog
    </h1>
    <p class="mt-3 text-[0.9375rem] text-muted-foreground">
      Everything that has shipped, newest first.
    </p>
    <ChangelogTimeline />
  </main>
  {/* PageLayout takes its footer as a named slot, not the layout override. */}
  <Footer slot="footer" />
</PageLayout>
