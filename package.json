{
  "name": "neon-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The official Neon UI Registry — production-ready components and blocks for building modern applications on Neon.",
  "type": "module",
  "scripts": {
    "build": "pnpm build:registry && pnpm build:docs",
    "build:docs": "pnpm --filter docs build",
    "build:registry": "pnpm --filter @neon-ui/registry build",
    "check": "ultracite check",
    "check:fix": "ultracite fix",
    "dev": "pnpm --filter docs dev",
    "fix": "ultracite fix",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\" \"!**/node_modules/**\" \"!**/dist/**\"",
    "prepare": "husky",
    "sync:tokens": "node scripts/sync-theme-tokens.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:tokens": "node scripts/sync-theme-tokens.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.18.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "ultracite": "7.9.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.30.3"
}
